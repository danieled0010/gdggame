# Configure these in your hosting dashboard; Node does not load this file itself.
NODE_ENV=production
PUBLIC_BASE_URL=https://your-quiz.example.com
# Generate a private code: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=replace_with_a_random_code_of_at_least_32_characters
# For restart recovery, point to a persistent volume on your hosting provider.
DATA_DIR=./data
